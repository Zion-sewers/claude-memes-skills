{
  "_comment": "Add this 'hooks' block to your ~/.claude/settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/meme-post-bash.sh",
            "timeout": 1000
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/meme-post-skill.sh",
            "timeout": 1000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/meme-stop.sh",
            "timeout": 1000
          }
        ]
      }
    ]
  }
}
